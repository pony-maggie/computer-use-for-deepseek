DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_ROUTING=quality_first
DEEPSEEK_THINKING=enabled
APP_DATABASE_URL=sqlite:///./data/app.db
APP_WORKSPACE_ROOT=./workspace
APP_SCREENSHOT_ROOT=./screenshots
APP_MAX_STEPS=30
APP_TOKEN_BUDGET=2000000
APP_COST_BUDGET_USD=0
DEEPSEEK_INPUT_USD_PER_MTOK=0
DEEPSEEK_OUTPUT_USD_PER_MTOK=0
APP_RUNTIME_MODE=docker
RUNTIME_IMAGE=ghcr.io/pony-maggie/computer-use-for-deepseek-runtime:latest
RUNTIME_ACTION_URL=http://runtime:7070
RUNTIME_DISPLAY_WIDTH=1280
RUNTIME_DISPLAY_HEIGHT=800
RUNTIME_NOVNC_URL=http://localhost:6080/vnc.html
